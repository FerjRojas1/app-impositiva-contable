@model AppEstudioContable.Models.ClienteModel

@{
    ViewData["Title"] = "Crear Nuevo Cliente"; 
}

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-primary">
            
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-user-plus mr-2"></i>Crear Nuevo Cliente</h3> 
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                </div>
            </div>

            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken() 

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                       
                        <h4 class="alert-heading"><i class="fas fa-exclamation-triangle mr-2"></i>¡Por favor, corrige los siguientes errores!</h4>
                        <hr>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="mb-3 text-primary"><i class="fas fa-address-card mr-2"></i>Datos Personales</h5>
                            <hr class="mb-3" />

                            <div class="form-group mb-3">
                                <label asp-for="Dni" class="form-label"></label> 
                                <input asp-for="Dni" class="form-control" type="text" inputmode="numeric" pattern="\d{7,10}" title="Ingrese un DNI válido (7 a 10 dígitos numéricos)" placeholder="Ej: 12345678" />
                                <span asp-validation-for="Dni" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Apellido" class="form-label"></label>
                                <input asp-for="Apellido" class="form-control" placeholder="Ej: Pérez" />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="Ej: correo@ejemplo.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5 class="mb-3 text-primary"><i class="fas fa-building mr-2"></i>Datos Fiscales</h5> 
                            <hr class="mb-3" />

                            <div class="form-group mb-3">
                                <label asp-for="Cuit" class="form-label"></label> 
                                <input asp-for="Cuit" class="form-control" type="text" inputmode="numeric" pattern="\d{11}" title="El CUIT debe contener exactamente 11 dígitos numéricos." placeholder="Ej: 20123456789" />
                                <span asp-validation-for="Cuit" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="RazonSocial" class="form-label"></label>
                                <input asp-for="RazonSocial" class="form-control" placeholder="Ej: Mi Empresa S.A." />
                                <span asp-validation-for="RazonSocial" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="DomFiscal" class="form-label"></label>
                                <input asp-for="DomFiscal" class="form-control" placeholder="Ej: Av. Principal 123, Ciudad" />
                                <span asp-validation-for="DomFiscal" class="text-danger"></span>
                            </div>

                            
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 border-top pt-3">
                        <a asp-action="Index" class="btn btn-secondary btn-lg btn-shine">
                            <i class="fas fa-times-circle mr-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg btn-shine">
                            
                            <i class="fas fa-check-circle mr-1"></i> Crear Cliente
                        </button>
       
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}