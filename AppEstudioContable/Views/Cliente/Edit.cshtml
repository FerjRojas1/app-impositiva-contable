@using ServiciosEC.Models
@model AppEstudioContable.Models.ClienteModel

@{
    ViewData["Title"] = "Editar Cliente";
    var successMessage = TempData["SuccessMessage"] as string;
}

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-info">
            
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-edit mr-2"></i>Editar Cliente: <strong>@Model.Nombre @Model.Apellido</strong></h3> @* Added icon and client name to title *@
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                </div>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i> @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div> 
                    <input type="hidden" asp-for="id" />

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="mb-3 text-info"><i class="fas fa-user mr-2"></i>Datos Personales</h5>
                            <hr class="mb-3" />

                            <div class="form-group mb-3">
                               
                                <label asp-for="Nombre" class="form-label"></label> 
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Apellido" class="form-label"></label>
                                <input asp-for="Apellido" class="form-control" />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Dni" class="form-label"></label>
                                <input asp-for="Dni" class="form-control" type="text" inputmode="numeric" pattern="\d{7,10}" title="Ingrese un DNI válido (7 a 10 dígitos numéricos)" />
                                <span asp-validation-for="Dni" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Cuit" class="form-label"></label>
                                <input asp-for="Cuit" class="form-control" type="text" inputmode="numeric" pattern="\d{11}" title="El CUIT debe contener exactamente 11 dígitos numéricos." />
                                <span asp-validation-for="Cuit" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5 class="mb-3 text-info"><i class="fas fa-address-card mr-2"></i>Datos Fiscales y Contacto</h5>
                            <hr class="mb-3" />

                            <div class="form-group mb-3">
                                <label asp-for="RazonSocial" class="form-label"></label>
                                <input asp-for="RazonSocial" class="form-control" />
                                <span asp-validation-for="RazonSocial" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="DomFiscal" class="form-label"></label>
                                <input asp-for="DomFiscal" class="form-control" />
                                <span asp-validation-for="DomFiscal" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>


                            @if (Model.EstadoId == 2)
                            {
                                <h5 class="mt-4 mb-3 text-info"><i class="fas fa-user-tag mr-2"></i>Configuración de Rol</h5> 
                                <hr class="mb-3" />
                                <div class="form-group mb-4">
                                    <label asp-for="EstadoId" class="form-label">Estado/Rol del Cliente</label>
                                    <select asp-for="EstadoId" class="form-select">
                                        <option value="" disabled selected>Seleccione un estado</option>
                                        @foreach (Estado estado in Model.Estados)
                                        {
                                            <option value="@estado.IdEstado">@estado.Descripcion</option>
                                        }
                                    </select>
                                    <span asp-validation-for="EstadoId" class="text-danger"></span>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" asp-for="EstadoId" />
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 border-top pt-3">
                        
                        <button type="submit" class="btn btn-primary btn-shine">
                         
                            <i class="fas fa-save mr-1"></i> Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-shine">
                            <i class="fas fa-arrow-left mr-1"></i> Volver a la Lista
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}