@model AppEstudioContable.Models.UsuarioModel

@{
    ViewData["Title"] = $"Detalles del Usuario: {Model.nombre} {Model.apellido}"; // Título más específico
}

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-info"> @* Cambiamos a card-info para un look más "informativo" *@
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-user-circle mr-2"></i>Detalles del Usuario: <strong>@Model.nombre @Model.apellido</strong></h3> @* Icono y nombre del usuario en el título *@
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                </div>
            </div>

            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <h4 class="alert-heading"><i class="fas fa-exclamation-triangle mr-2"></i>¡Error al cargar los detalles!</h4>
                        <hr>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p class="mb-0">@error.ErrorMessage</p>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="row">
                    <div class="col-md-6">
                        <h5 class="mb-3 text-info"><i class="fas fa-id-card mr-2"></i>Información Personal</h5>
                        <hr />
                        <dl class="row mb-4">
                            <dt class="col-sm-4 text-dark font-weight-bold">Nombre:</dt>
                            <dd class="col-sm-8">@Model.nombre</dd>

                            <dt class="col-sm-4 text-dark font-weight-bold">Apellido:</dt>
                            <dd class="col-sm-8">@Model.apellido</dd>

                            <dt class="col-sm-4 text-dark font-weight-bold">DNI:</dt>
                            <dd class="col-sm-8">@Model.dni</dd>

                            <dt class="col-sm-4 text-dark font-weight-bold">Teléfono:</dt>
                            <dd class="col-sm-8">@Model.telefono</dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <h5 class="mb-3 text-info"><i class="fas fa-user-cog mr-2"></i>Detalles de Cuenta</h5>
                        <hr />
                        <dl class="row mb-4">
                            <dt class="col-sm-4 text-dark font-weight-bold">Nombre de Usuario:</dt>
                            <dd class="col-sm-8">@Model.nombre_usuario</dd>

                            <dt class="col-sm-4 text-dark font-weight-bold">Correo Electrónico:</dt>
                            <dd class="col-sm-8">@Model.email</dd>

                            <dt class="col-sm-4 text-dark font-weight-bold">Rol:</dt>
                            <dd class="col-sm-8">@Model.rol?</dd>
                        </dl>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 border-top pt-3">
                   
                        
                    <a asp-action="Index" class="btn btn-secondary btn-lg btn-shine">
                        <i class="fas fa-arrow-left mr-1"></i> Volver a la Lista
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>