@model Dictionary<string, ServiciosEC.Utilidades.ModelosDTO.TotalesIVA>

@{
    ViewData["Title"] = "Totales Compras";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="text-dark">Totales de Compras</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @foreach (var item in Model)
        {
            <div class="card card-gray mb-4">
                <div class="card-header">
                    <h3 class="card-title">Factura Tipo: @item.Key</h3>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover mb-0">
                            <thead class="bg-light text-center">
                                <tr>
                                    <th>Neto Gravado</th>
                                    <th>IVA 21%</th>
                                    <th>IVA 10.5%</th>
                                    <th>No Gravado</th>
                                    <th>Exento</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="text-center">
                                    <td>@item.Value.NetoGravado.ToString("C")</td>
                                    <td>@item.Value.Iva21.ToString("C")</td>
                                    <td>@item.Value.Iva105.ToString("C")</td>
                                    <td>@item.Value.NoGravado.ToString("C")</td>
                                    <td>@item.Value.Exento.ToString("C")</td>
                                    <td>@item.Value.TotalGeneral.ToString("C")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @* Totales globales *@
        @{
            var totalNetoGravadoGlobal = Model.Sum(x => x.Value.NetoGravado);
            var totalIva21Global = Model.Sum(x => x.Value.Iva21);
            var totalIva105Global = Model.Sum(x => x.Value.Iva105);
            var totalNoGravadoGlobal = Model.Sum(x => x.Value.NoGravado);
            var totalExentoGlobal = Model.Sum(x => x.Value.Exento);
            var totalGeneralGlobal = Model.Sum(x => x.Value.TotalGeneral);
        }

        <div class="card card-gray mb-5">
            <div class="card-header">
                <h3 class="card-title">Resumen Global de Compras</h3>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead class="bg-light text-center">
                            <tr>
                                <th>Neto Gravado (Global)</th>
                                <th>IVA 21%</th>
                                <th>IVA 10.5%</th>
                                <th>No Gravado</th>
                                <th>Exento</th>
                                <th>Total General</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="text-center bg-white">
                                <td><strong>@totalNetoGravadoGlobal.ToString("C")</strong></td>
                                <td><strong>@totalIva21Global.ToString("C")</strong></td>
                                <td><strong>@totalIva105Global.ToString("C")</strong></td>
                                <td><strong>@totalNoGravadoGlobal.ToString("C")</strong></td>
                                <td><strong>@totalExentoGlobal.ToString("C")</strong></td>
                                <td><strong>@totalGeneralGlobal.ToString("C")</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>


<div class="mt-4 ms-3">
    <button type="button" onclick="window.history.back()" class="btn btn-outline-secondary btn-shine">
        <i class="fas fa-arrow-left"></i> Volver
    </button>
</div>
