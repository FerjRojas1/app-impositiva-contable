
@model IEnumerable<ServiciosEC.Models.Venta>

@{
    ViewData["Title"] = "Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card border-0 shadow-sm bg-light mb-4">
    <div class="card-body text-center">
        <h5 class="mb-0 text-dark">
            <span class="text-muted">Cliente CUIT:</span> @ViewBag.Cuit
        </h5>
    </div>
</div>

<h2 class="text-center text-info mb-4">Ventas</h2>

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-info bg-opacity-25 text-center rounded-top-4">
                    <h5 class="mb-0 text-dark fw-semibold">📅 Búsqueda por Período</h5>
                </div>
                <div class="card-body bg-white">
                    <div class="row mb-4 justify-content-center">
                        <div class="col-md-4 col-sm-6">
                            <label for="mesInput" class="form-label">Mes (MM)</label>
                            <input type="text" id="mesInput" name="mes" class="form-control form-control-sm shadow-sm" placeholder="Ej: 01" value="@ViewBag.Mes">
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <label for="anoInput" class="form-label">Año (AAAA)</label>
                            <input type="text" id="anoInput" name="ano" class="form-control form-control-sm shadow-sm" placeholder="Ej: 2023" value="@ViewBag.Ano">
                        </div>
                    </div>

                    <hr class="mb-4 mt-0 border-gray" />

                    <div class="row g-3 justify-content-center">
                        <div class="col-md-6 col-lg-4 d-grid gap-2">
                            <button type="button" id="filtrarListadoBtn" class="btn btn-outline-primary btn-lg rounded-pill btn-shine">
                                <i class="fas fa-filter me-2"></i> Filtrar Listado de Ventas
                            </button>
                            <button type="button" id="limpiarFiltrosBtn" class="btn btn-outline-secondary btn-lg rounded-pill btn-shine">
                                <i class="fas fa-eraser me-2"></i> Limpiar Filtros
                            </button>
                            
                        </div>

                        <div class="col-md-6 col-lg-4 d-grid gap-2">
                            <button type="button" id="verTotalesComprobanteBtn" class="btn btn-outline-success btn-lg rounded-pill btn-shine">
                                <i class="fas fa-file-invoice me-2"></i> Ver Totales por Comprobante
                            </button>
                            @* <button type="button" id="verTotalNetoBtn" class="btn btn-outline-info btn-lg rounded-pill btn-shine">
                                <i class="fas fa-money-bill-alt me-2"></i> Ver Total Neto
                            </button> *@
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<input type="hidden" id="clienteCuit" value="@ViewBag.Cuit" />



@if (TempData["MensajeExitoCarga"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensajeExitoCarga"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewBag.AnoSeleccionado > 0)
{
    @if (Model != null && Model.Any())
    {
        <div class="container-fluid">
            <div class="card shadow border-dark mb-6">
                <div class="card-header bg-dark text-white">
                    <strong>Facturas Cargadas</strong>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table id="tablaVentas" class="table table-striped table-hover m-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Tipo de Factura</th>
                                    <th>Punto de Venta</th>
                                    <th>Numero Desde</th>
                                    <th>Numero Documento Comprador</th>
                                    <th>Denominacion Comprador</th>
                                    <th>Moneda</th>
                                    <th>Neto Gravado</th>
                                    <th>No Gravado</th>
                                    <th>Exento</th>
                                    <th>Iva</th>
                                    <th>Total</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(m => item.Fecha)</td>
                                        <td>@Html.DisplayFor(m => item.TipoFact)</td>
                                        <td>@Html.DisplayFor(m => item.PuntoVenta)</td>
                                        <td>@Html.DisplayFor(m => item.NroDesde)</td>
                                        <td>@Html.DisplayFor(m => item.NroDocComprador)</td>
                                        <td>@Html.DisplayFor(m => item.DenomComprador)</td>
                                        <td>@Html.DisplayFor(m => item.Moneda)</td>
                                        <td>@Html.DisplayFor(m => item.NetoGravado)</td>
                                        <td>@Html.DisplayFor(m => item.NoGravado)</td>
                                        <td>@Html.DisplayFor(m => item.Exento)</td>
                                        <td>@Html.DisplayFor(m => item.Iva)</td>
                                        <td>@Html.DisplayFor(m => item.Total)</td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a asp-action="Edit" asp-route-id="@item.IdVenta" asp-route-cuit="@ViewBag.Cuit" class="btn btn-secondary btn-sm">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.IdVenta" asp-route-cuit="@ViewBag.Cuit" class="btn btn-info btn-sm">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.IdVenta" asp-route-cuit="@ViewBag.Cuit" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center" role="alert">
            No hay ventas cargadas para el cliente con CUIT: @ViewBag.Cuit @(ViewBag.MesSeleccionado > 0 ? $"en el mes {ViewBag.MesSeleccionado}" : "") @(ViewBag.AnoSeleccionado > 0 ? $"del año {ViewBag.AnoSeleccionado}" : "").
        </div>
    }
}




<div class="mt-4 ms-3">
    <a asp-controller="Cliente"
       asp-action="Details"
       asp-route-id="@ViewBag.Id"
       class="btn btn-outline-secondary btn-shine">
        <i class="fas fa-arrow-left"></i> Volver
    </a>
</div>



@section Scripts {
    <script src="~/js/ventas.js"></script>
    <script>
        let idTabla = new DataTable('#tablaVentas');
    </script>
}

