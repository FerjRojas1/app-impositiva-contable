@model AppEstudioContable.Models.VentaViewModel

@{
    ViewData["Title"] = "Gestión de Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 
<style>
   
    body {
        background-color: #f8f9fa;
    }
    
    .card {
        border: none; 
        border-radius: 1rem; 
        overflow: hidden; 
        transition: all 0.3s ease; 
    }
    /*
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important; 
        }
        */
    .card-header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
        font-size: 1.25rem; 
        padding: 1.25rem 1.5rem; 
    }
    
    .btn-shine {
        position: relative;
        overflow: hidden;
        z-index: 1;
    }
    
        .btn-shine::before {
            content: '';
            position: absolute;
            top: 0;
            left: -75%;
            width: 50%;
            height: 100%;
            background: rgba(255, 255, 255, 0.3);
            transform: skewX(-20deg);
            transition: all 0.7s cubic-bezier(0.165, 0.84, 0.44, 1);
            z-index: -1;
        }

        .btn-shine:hover::before {
            left: 125%;
        }

    .table th, .table td {
        vertical-align: middle; 
    }

    .form-control:focus {
        border-color: #80bdff;
        box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25);
    }


    .modal-body .form-group label {
        font-weight: 600;
        color: #555;
    }

    details {
        margin-bottom: 1rem;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        padding: 0.75rem;
        background-color: #f1f1f1;
        transition: all 0.3s ease;
    }

        details:hover {
            background-color: #e9ecef;
        }

    summary {
        font-weight: bold;
        cursor: pointer;
        outline: none;
        color: #007bff;
    }

        summary:hover {
            color: #0056b3;
        }

    details[open] summary {
        border-bottom: 1px solid #dee2e6;
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
    } 

    .modal-body {
        max-height: 70vh;
        overflow-y: auto;
    }

</style>

<h2 class="text-center text-primary mb-5 animate__animated animate__fadeInDown">
    <i class="fas fa-file-invoice-dollar me-3"></i>Gestión de Ventas
</h2>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show animate__animated animate__fadeIn" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show animate__animated animate__fadeIn" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="container my-5">
    <div class="row g-4">
        @* Sección para importar ventas desde Excel *@
        <div class="col-md-6">
            <div class="card shadow-lg h-100">
                <div class="card-header bg-gradient-light text-secondary">
                    <i class="fas fa-file-excel me-2"></i>Importar Ventas desde Excel
                </div>

                <div class="card-body p-4">
                    <p class="card-text text-muted mb-4">Carga masiva de ventas mediante un archivo Excel.</p>

                    <form id="formCargaExcel" asp-controller="Ventas" asp-action="Altas" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="file" class="form-label fw-semibold text-dark">
                                Selecciona un archivo <span class="text-primary">(formatos .xlsx, .xls, .csv)</span>
                            </label>
                            <input type="file" name="file" id="file" accept=".xlsx,.xls,.csv" class="form-control" required />
                            <div class="invalid-feedback" id="fileValidationError">
                                Por favor, selecciona un archivo válido de Excel.
                            </div>
                            <div id="fileError" class="text-danger small mt-2"></div>
                        </div>

                        <input type="hidden" name="id" value="@Model.id" />

                        @Html.ValidationSummary(true, "", new { @class = "text-danger mt-3" })

                        <button type="submit" id="btnCargar" class="btn btn-primary btn-lg w-100 btn-shine">
                            <i class="fas fa-upload me-2"></i>Cargar Ventas
                        </button>

                        <!-- Modal de carga -->
                        <div class="modal fade" id="modalCargando" tabindex="-1" aria-labelledby="modalCargandoLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content bg-light text-center shadow">
                                    <div class="modal-body p-5">
                                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                                            <span class="sr-only">Cargando...</span>
                                        </div>
                                        <h5 class="mb-0 text-secondary">Procesando archivo, por favor espera...</h5>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                
            </div>
        </div>

        @* Sección para cargar venta manual *@
        <div class="col-md-6">
            <div class="card shadow-lg h-100">
                <div class="card-header bg-gradient-light text-secondary">
                    <i class="fas fa-plus-circle me-2"></i>Cargar Venta Manual
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <p class="card-text text-muted mb-4">Ingresa una nueva venta manualmente, completando todos los detalles.</p>
                    <form asp-controller="Ventas" asp-action="Create" method="get" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="@Model.id" />
                        <button type="submit" class="btn btn-info btn-lg w-100 btn-shine">
                            <i class="fas fa-pencil-alt me-2"></i>Nueva Venta
                        </button>
                    </form>
                </div>
            </div>
      
        
        </div>
    </div>
</div>



@* Bloque de Facturas Para Revisar *@
@if (Model.ventasParaRevisar != null && Model.ventasParaRevisar.Any())
{
    <div class="container-fluid my-5">
        <div class="card shadow-lg border-warning">
            <div class="card-header bg-warning text-black">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Facturas Para Revisar (@Model.ventasParaRevisar.Count())</strong>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="ventasParaRevisar" class="table table-striped table-hover m-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo de Factura</th>
                                <th>Punto de Venta</th>
                                <th>Numero Desde</th>
                                <th>Numero Documento Comprador</th>
                                <th>Denominacion Comprador</th>
                                <th>Moneda</th>
                                <th>Neto Gravado</th>
                                <th>Iva</th>
                                <th>Total</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ventasParaRevisar)
                            {
                                <tr data-id="@item.IdVenta">
                                    <td>@Html.DisplayFor(m => item.Fecha)</td>
                                    <td>@Html.DisplayFor(m => item.TipoFact)</td>
                                    <td>@Html.DisplayFor(m => item.PuntoVenta)</td>
                                    <td>@Html.DisplayFor(m => item.NroDesde)</td>
                                    <td>@Html.DisplayFor(m => item.NroDocComprador)</td>
                                    <td>@Html.DisplayFor(m => item.DenomComprador)</td>
                                    <td>@Html.DisplayFor(m => item.Moneda)</td>
                                    <td>@Html.DisplayFor(m => item.NetoGravado)</td>
                                    <td>@Html.DisplayFor(m => item.Iva)</td>
                                    <td>@Html.DisplayFor(m => item.Total)</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group" aria-label="Acciones de Venta">
                                            @* Botón para abrir el modal de edición *@
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-toggle="modal" data-target="#modalEdit_@item.IdVenta" title="Editar Venta">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        </div>

                                        @* Formulario emergente (Modal) para edición *@
                                        <div class="modal fade" id="modalEdit_@item.IdVenta" tabindex="-1" aria-labelledby="modalLabelEdit_@item.IdVenta" aria-hidden="true">
                                            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                                <div class="modal-content">
                                                    <form method="post" action="/Ventas/Edit2">
                                                        @Html.AntiForgeryToken() 
                                                        <input type="hidden" name="IdVenta" value="@item.IdVenta" />
                                                        <div class="modal-header bg-info text-white">
                                                            <h5 class="modal-title" id="modalLabelEdit_@item.IdVenta">
                                                                <i class="fas fa-pencil-alt me-2"></i>Editar Venta #@item.IdVenta
                                                            </h5>
                                                        </div>
                                                        <div class="modal-body text-start">
                                                            <details open>
                                                               
                                                                <summary>Datos Principales de la Venta</summary>
                                                                <div class="row gx-3">
                                                                    <div class="col-md-6 mb-3">
                                                                        <label for="Fecha_@item.IdVenta" class="form-label">Fecha</label>
                                                                        <input type="date" class="form-control" id="Fecha_@item.IdVenta" name="Fecha" value="@item.Fecha.ToString("yyyy-MM-dd")" required />
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label for="TipoFact_@item.IdVenta" class="form-label">Tipo Factura</label>
                                                                        <input type="text" class="form-control" id="TipoFact_@item.IdVenta" name="TipoFact" value="@item.TipoFact" required />
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label for="PuntoVenta_@item.IdVenta" class="form-label">Punto de Venta</label>
                                                                        <input type="text" class="form-control" id="PuntoVenta_@item.IdVenta" name="PuntoVenta" value="@item.PuntoVenta" required />
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label for="NroDesde_@item.IdVenta" class="form-label">Número Desde</label>
                                                                        <input type="text" class="form-control" id="NroDesde_@item.IdVenta" name="NroDesde" value="@item.NroDesde" required />
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label for="NroHasta_@item.IdVenta" class="form-label">Número Hasta</label>
                                                                        <input type="text" class="form-control" id="NroHasta_@item.IdVenta" name="NroHasta" value="@item.NroHasta" required />
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label for="Moneda_@item.IdVenta" class="form-label">Moneda</label>
                                                                        <input type="text" class="form-control" id="Moneda_@item.IdVenta" name="Moneda" value="@item.Moneda" required />
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label for="TipoCambio_@item.IdVenta" class="form-label">Tipo de Cambio</label>
                                                                        <input type="text" class="form-control" id="TipoCambio_@item.IdVenta" name="TipoCambio" value="@item.TipoCambio" required />
                                                                    </div>
                                                                </div>
                                                            </details>

                                                            <details>
                                                                <summary>Datos del Comprador</summary>
                                                                <div class="row gx-3">
                                                                    <div class="col-md-6 mb-3">
                                                                        <label for="DenomComprador_@item.IdVenta" class="form-label">Denominación Comprador</label>
                                                                        <input type="text" class="form-control" id="DenomComprador_@item.IdVenta" name="DenomComprador" value="@item.DenomComprador" />
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label for="TipoDocComprador_@item.IdVenta" class="form-label">Tipo Documento</label>
                                                                        <input type="text" class="form-control" id="TipoDocComprador_@item.IdVenta" name="TipoDocComprador" value="@item.TipoDocComprador" required />
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label for="NroDocComprador_@item.IdVenta" class="form-label">Número Documento</label>
                                                                        <input type="text" class="form-control" id="NroDocComprador_@item.IdVenta" name="NroDocComprador" value="@item.NroDocComprador" required />
                                                                    </div>
                                                                </div>
                                                            </details>

                                                            <details>
                                                                <summary>Detalles de Importes (Moneda Local)</summary>
                                                                <div class="row gx-3">
                                                                    <div class="col-md-4 mb-3">
                                                                        <label for="NetoGravado_@item.IdVenta" class="form-label">Neto Gravado</label>
                                                                        <input type="text" class="form-control" id="NetoGravado_@item.IdVenta" name="NetoGravado" value="@item.NetoGravado" />
                                                                    </div>
                                                                    <div class="col-md-4 mb-3">
                                                                        <label for="NoGravado_@item.IdVenta" class="form-label">No Gravado</label>
                                                                        <input type="text" class="form-control" id="NoGravado_@item.IdVenta" name="NoGravado" value="@item.NoGravado" />
                                                                    </div>
                                                                    <div class="col-md-4 mb-3">
                                                                        <label for="Exento_@item.IdVenta" class="form-label">Exento</label>
                                                                        <input type="text" class="form-control" id="Exento_@item.IdVenta" name="Exento" value="@item.Exento" />
                                                                    </div>
                                                                    <div class="col-md-4 mb-3">
                                                                        <label for="Iva_@item.IdVenta" class="form-label">IVA Total</label>
                                                                        <input type="text" class="form-control" id="Iva_@item.IdVenta" name="Iva" value="@item.Iva" />
                                                                    </div>
                                                                    <div class="col-md-4 mb-3">
                                                                        <label for="Total_@item.IdVenta" class="form-label">Total Factura</label>
                                                                        <input type="text" class="form-control" id="Total_@item.IdVenta" name="Total" value="@item.Total" />
                                                                    </div>
                                                                </div>
                                                            </details>

                                                            <details>
                                                                <summary>Desglose de IVA y Gravados por Alícuota</summary>
                                                                <div class="row gx-3">
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Iva0_@item.IdVenta" class="form-label">IVA 0%</label>
                                                                        <input type="text" class="form-control" id="Iva0_@item.IdVenta" name="Iva0" value="@item.Iva0" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Iva5_@item.IdVenta" class="form-label">IVA 5%</label>
                                                                        <input type="text" class="form-control" id="Iva5_@item.IdVenta" name="Iva5" value="@item.Iva5" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Iva105_@item.IdVenta" class="form-label">IVA 10.5%</label>
                                                                        <input type="text" class="form-control" id="Iva105_@item.IdVenta" name="Iva105" value="@item.Iva105" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Iva21_@item.IdVenta" class="form-label">IVA 21%</label>
                                                                        <input type="text" class="form-control" id="Iva21_@item.IdVenta" name="Iva21" value="@item.Iva21" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Iva25_@item.IdVenta" class="form-label">IVA 2.5%</label>
                                                                        <input type="text" class="form-control" id="Iva25_@item.IdVenta" name="Iva25" value="@item.Iva25" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Iva27_@item.IdVenta" class="form-label">IVA 27%</label>
                                                                        <input type="text" class="form-control" id="Iva27_@item.IdVenta" name="Iva27" value="@item.Iva27" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Grav0_@item.IdVenta" class="form-label">Gravado 0%</label>
                                                                        <input type="text" class="form-control" id="Grav0_@item.IdVenta" name="Grav0" value="@item.Grav0" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Grav5_@item.IdVenta" class="form-label">Gravado 5%</label>
                                                                        <input type="text" class="form-control" id="Grav5_@item.IdVenta" name="Grav5" value="@item.Grav5" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Grav105_@item.IdVenta" class="form-label">Gravado 10.5%</label>
                                                                        <input type="text" class="form-control" id="Grav105_@item.IdVenta" name="Grav105" value="@item.Grav105" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Grav21_@item.IdVenta" class="form-label">Gravado 21%</label>
                                                                        <input type="text" class="form-control" id="Grav21_@item.IdVenta" name="Grav21" value="@item.Grav21" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Grav25_@item.IdVenta" class="form-label">Gravado 2.5%</label>
                                                                        <input type="text" class="form-control" id="Grav25_@item.IdVenta" name="Grav25" value="@item.Grav25" />
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label for="Grav27_@item.IdVenta" class="form-label">Gravado 27%</label>
                                                                        <input type="text" class="form-control" id="Grav27_@item.IdVenta" name="Grav27" value="@item.Grav27" />
                                                                    </div>
                                                                </div>
                                                            </details>
                                                        </div>
       
                                                        <div class="modal-footer">

                                                            <button type="button" class="btn btn-success btn-guardar-modal" data-id="@item.IdVenta">Guardar</button>
                                                            @* <button type="submit" class="btn btn-success btn-shine"> <i class="fas fa-save me-2"></i>Guardar Cambios </button> *@
                                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
           
                                    
                                    
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}




@if (Model.ventasCorrectas.Any())
{
    <div class="container-fluid my-5">
        <div class="card shadow-lg border-success">
            <div class="card-header bg-success text-white">
                <i class="fas fa-check-double me-2"></i>
                <strong>Facturas Cargadas Correctamente (@Model.ventasCorrectas.Count())</strong>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="ventasCorrectas" class="table table-striped table-hover m-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo de Factura</th>
                                <th>Punto de Venta</th>
                                <th>Numero Desde</th>
                                <th>Numero Documento Comprador</th>
                                <th>Denominacion Comprador</th>
                                <th>Moneda</th>
                                <th>Neto Gravado</th>
                                <th>Iva</th>
                                <th>Total</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ventasCorrectas)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(m => item.Fecha)</td>
                                    <td>@Html.DisplayFor(m => item.TipoFact)</td>
                                    <td>@Html.DisplayFor(m => item.PuntoVenta)</td>
                                    <td>@Html.DisplayFor(m => item.NroDesde)</td>
                                    <td>@Html.DisplayFor(m => item.NroDocComprador)</td>
                                    <td>@Html.DisplayFor(m => item.DenomComprador)</td>
                                    <td>@Html.DisplayFor(m => item.Moneda)</td>
                                    <td>@Html.DisplayFor(m => item.NetoGravado)</td>
                                    <td>@Html.DisplayFor(m => item.Iva)</td>
                                    <td>@Html.DisplayFor(m => item.Total)</td>
                                    <td>
                                        <div class="btn-group" role="group" aria-label="Acciones de Venta">
                                            @* Botón para abrir el modal de info *@
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-toggle="modal" data-target="#modalEdit_@item.IdVenta" title="+Info">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
