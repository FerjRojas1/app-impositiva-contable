<div class="mt-2">
    <a asp-controller="Cliente"
       asp-action="Details"
       asp-route-id="@Model.id"
       class="btn btn-light border border-secondary text-muted">
        <i class="fas fa-arrow-left me-2"></i> Volver
    </a>
</div>

@section Scripts {
    <script src="~/js/ventas.js"></script>
    <script>
       
        $(document).ready(function () {
         
            if ($.fn.DataTable.isDataTable('#ventasParaRevisar')) {
                $('#ventasParaRevisar').DataTable().destroy();
            }
            $('#ventasParaRevisar').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json" 
                },
                "paging": true,     
                "ordering": true,    
                "info": true,        
                "searching": true    
            });

            // Para "ventasCorrectas"
            if ($.fn.DataTable.isDataTable('#ventasCorrectas')) {
                $('#ventasCorrectas').DataTable().destroy();
            }
            $('#ventasCorrectas').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                },
                "paging": true,
                "ordering": true,
                "info": true,
                "searching": true
            });
            // Para "ventasFallidas"
            if ($.fn.DataTable.isDataTable('#ventasFallidas')) {
                $('#ventasFallidas').DataTable().destroy();
            }
            $('#ventasFallidas').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                },
                "paging": true,
                "ordering": true,
                "info": true,
                "searching": true
            });
        });



         document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('formCargaExcel');
            const fileInput = document.getElementById('file');
            const fileValidationErrorDiv = document.getElementById('fileValidationError');
            const btnCargar = document.getElementById('btnCargar');
            const allowedExtensions = /\.(xlsx|xls|csv)$/i;

            form.addEventListener('submit', function (e) {
                // Limpiar errores previos
                fileInput.classList.remove('is-invalid');
                fileValidationErrorDiv.style.display = 'none';

                // Validaciones
                if (fileInput.files.length === 0) {
                    e.preventDefault();
                    fileInput.classList.add('is-invalid');
                    fileValidationErrorDiv.textContent = 'Por favor, selecciona un archivo.';
                    fileValidationErrorDiv.style.display = 'block';
                    return;
                }

                if (!allowedExtensions.test(fileInput.value)) {
                    e.preventDefault();
                    fileInput.classList.add('is-invalid');
                    fileValidationErrorDiv.textContent = 'Formato de archivo no válido. Solo se permiten .xlsx, .xls o .csv.';
                    fileValidationErrorDiv.style.display = 'block';
                    fileInput.value = '';
                    return;
                }

                // Si pasa la validación, mostramos el modal y desactivamos el botón
                btnCargar.disabled = true;
                const modal = new bootstrap.Modal(document.getElementById('modalCargando'));
                modal.show();
            });

            // Drag & Drop (opcional y visual)
            const dropZone = fileInput.closest('.mb-3');
            dropZone.addEventListener('dragover', function (e) {
                e.preventDefault();
                dropZone.classList.add('border', 'border-primary', 'bg-light');
            });
            dropZone.addEventListener('dragleave', function () {
                dropZone.classList.remove('border', 'border-primary', 'bg-light');
            });
            dropZone.addEventListener('drop', function () {
                dropZone.classList.remove('border', 'border-primary', 'bg-light');
            });
        });
    </script>



    
}
