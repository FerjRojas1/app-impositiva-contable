@model IEnumerable<ServiciosEC.Models.Venta>

@{
    ViewData["Title"] = "Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content">
        <div class="container-fluid mt-4">
            <h2 class="text-center text-info mb-4">Ventas</h2>

            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="card shadow-sm border-0 rounded-3 modern-card">
                        <div class="card-header bg-info text-white text-center">
                            <h5 class="mb-0">Busqueda por Período </h5>
                        </div>
                        <div class="card-body bg-light">

                            <input type="hidden" id="clienteCuit" value="@ViewBag.Cuit" />

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="mesInput">Mes (MM)</label>
                                        <input type="text" id="mesInput" name="mes" class="form-control" placeholder="Ej: 01" value="@ViewBag.Mes">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="anoInput">Año (AAAA)</label>
                                        <input type="text" id="anoInput" name="ano" class="form-control" placeholder="Ej: 2023" value="@ViewBag.Ano">
                                    </div>
                                </div>                              
                            </div>
                            <hr />

                            <div class="row">
                                <div class="col-md-6">
                                    <button type="button" id="verTotalNetoBtn" class="btn btn-outline-info w-100 mb-3 btn-shine">
                                        <i class="fas fa-money-bill-alt mr-2"></i> Total Neto Gravado
                                    </button>
                                    <button type="button" id="verTotalesComprobanteBtn" class="btn btn-outline-success w-100 mb-3 btn-shine">
                                        <i class="fas fa-file-invoice mr-2"></i> Totales por Comprobante
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <button type="button" id="filtrarListadoBtn" class="btn btn-outline-primary w-100 mb-3 btn-shine">
                                        <i class="fas fa-filter mr-2"></i> Buscar Ventas
                                    </button>
                                    <button type="button" id="limpiarFiltrosBtn" class="btn btn-outline-secondary w-100 mb-3 btn-shine">
                                        <i class="fas fa-times mr-2"></i> Limpiar Filtros
                                    </button>                                  
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
 </div>

        <div class="card shadow border-info mb-4">
            <div class="card-header bg-info text-white">
                <strong>Facturas Cargadas</strong>
            </div>
            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table id="tablaVentas" class="table table-striped table-hover m-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.First().Fecha)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().TipoFact)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().PuntoVenta)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().NroDesde)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().NroDocComprador)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().DenomComprador)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().Moneda)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().NetoGravado)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().NoGravado)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().Exento)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().Iva)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().Total)</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(m => item.Fecha)</td>
                                        <td>@Html.DisplayFor(m => item.TipoFact)</td>
                                        <td>@Html.DisplayFor(m => item.PuntoVenta)</td>
                                        <td>@Html.DisplayFor(m => item.NroDesde)</td>
                                        <td>@Html.DisplayFor(m => item.NroDocComprador)</td>
                                        <td>@Html.DisplayFor(m => item.DenomComprador)</td>
                                        <td>@Html.DisplayFor(m => item.Moneda)</td>
                                        <td>@Html.DisplayFor(m => item.NetoGravado)</td>
                                        <td>@Html.DisplayFor(m => item.NoGravado)</td>
                                        <td>@Html.DisplayFor(m => item.Exento)</td>
                                        <td>@Html.DisplayFor(m => item.Iva)</td>
                                        <td>@Html.DisplayFor(m => item.Total)</td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group" aria-label="Acciones">
                                                <a asp-action="Edit" asp-route-id="@item.IdVenta" asp-route-cuit="@ViewBag.Cuit" class="btn btn-sm btn-secondary" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.IdVenta" asp-route-cuit="@ViewBag.Cuit" class="btn btn-sm btn-info" title="Detalle">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.IdVenta" asp-route-cuit="@ViewBag.Cuit" class="btn btn-sm btn-danger" title="Eliminar">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning m-3 text-center">
                        No hay ventas cargadas para el cliente con CUIT: <strong>@ViewBag.Cuit</strong>
                        @(ViewBag.MesSeleccionado > 0 ? $" en el mes {ViewBag.MesSeleccionado}" : "")
                        @(ViewBag.AnoSeleccionado > 0 ? $" del año {ViewBag.AnoSeleccionado}" : "").
                    </div>
                }
            </div>
        </div>

    




@section Scripts {
    <script src="~/js/ventas.js"></script>
    <script>
        let idTabla = new DataTable('#tablaVentas');
    </script>
}

@section Styles {
    <style>
        .modern-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.3s ease;
        }

            .modern-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
            }

        .form-group label {
            font-weight: 500;
        }
    </style>
}