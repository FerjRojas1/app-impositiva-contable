@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

    <script>

        $.widget.bridge('uibutton', $.ui.button);
        $.widget.bridge('uitooltip', $.ui.tooltip);
    </script>

    <script>
        $(function () {

            function ini_events(ele) {
                ele.each(function () {
                    var eventObject = {
                        title: $.trim($(this).text()),
                        backgroundColor: $(this).css('background-color'),
                        borderColor: $(this).css('border-color'),
                        textColor: $(this).css('color'),
                        allDay: true
                    };
                    $(this).data('eventObject', eventObject);

                    $(this).draggable({
                        zIndex: 1070,
                        revert: true,
                        revertDuration: 0
                    });
                });
            }

            ini_events($('#external-events div.external-event'));

            // --- MANEJO DE SELECCIÓN DE COLOR PARA NUEVOS EVENTOS ---
            var currColor = '#0073b7';
            $('#event-color-chooser > li > a').click(function (e) {
                e.preventDefault();
                currColor = $(this).css('color');
                $('#event-color-chooser > li > a').removeClass('text-bold');
                $(this).addClass('text-bold');
            });


            $('#add-new-event').click(function (e) {
                e.preventDefault();
                var title = $('#new-event-title').val();
                if (title.length == 0) {

                    Swal.fire({
                        icon: 'warning',
                        title: 'Título Requerido',
                        text: 'El título del evento no puede estar vacío.',
                        confirmButtonText: 'Entendido'
                    });
                    return;
                }

                var newEventData = {
                    Titulo: title,
                    FechaInicio: moment(selectedDate).format('YYYY-MM-DDTHH:mm:ss'),
                    TodoElDia: true,
                    Color: currColor,
                    Descripcion: ""
                };

                $.ajax({
                    url: '/api/EventosAgenda',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(newEventData),
                    success: function(response) {
                        var event = $('<div />');
                        event.css({
                            'background-color': response.color,
                            'border-color': response.color,
                            'color': '#fff'
                        }).addClass('external-event ui-draggable ui-draggable-handle');
                        event.html(response.titulo);
                        event.data('eventObject', {
                            id: response.id,
                            title: response.titulo,
                            backgroundColor: response.color,
                            borderColor: response.color,
                            textColor: '#fff',
                            allDay: response.todoElDia
                        });
                        $('#external-events').prepend(event);

                        ini_events(event);

                        $('#new-event-title').val('');

                        Swal.fire({
                            icon: 'success',
                            title: '¡Éxito!',
                            text: 'Evento guardado y añadido a arrastrables.',
                            showConfirmButton: false,
                            timer: 1500
                        });
                        calendar.refetchEvents();
                    },
                    error: function(xhr, status, error) {

                        var errorMessage = xhr.responseText || 'Error desconocido al guardar el evento.';
                        Swal.fire({
                            icon: 'error',
                            title: 'Error al Guardar',
                            text: errorMessage,
                            confirmButtonText: 'Cerrar'
                        });
                        console.error('Error:', xhr.responseText);
                    }
                });
            });


            var calendarEl = document.getElementById('calendar');
            var checkbox = document.getElementById('drop-remove');
            var selectedDate = moment().format('YYYY-MM-DD'); 

            var calendar = new FullCalendar.Calendar(calendarEl, {

                plugins: ['bootstrap', 'interaction', 'dayGrid', 'timeGrid'],
                header: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                locale: 'es',
                themeSystem: 'bootstrap',
                buttonText: {
                    today: 'Hoy',
                    month: 'Mes',
                    week: 'Semana',
                    day: 'Día'
                },
                editable: true,
                droppable: true,
                selectable: true,

            
                selectAllow: function(selectInfo) {
                    
                    var today = FullCalendar.moment().startOf('day');

                   
                    var selectionStart = FullCalendar.moment(selectInfo.start).startOf('day');

                   
                    return !selectionStart.isBefore(today);
                },


                events: {
                    url: '/api/EventosAgenda',
                    method: 'GET',
                    failure: function() {

                        Swal.fire({
                            icon: 'error',
                            title: 'Error de Carga',
                            text: 'Hubo un error al cargar los eventos de la agenda.',
                            confirmButtonText: 'Cerrar'
                        });
                    }
                },

                dateClick: function(info) {
                    selectedDate = info.dateStr; // guardamos el día clickeado
                    // marcar visualmente el día seleccionado
                    $('.fc-day').removeClass('dia-seleccionado');
                    $(info.dayEl).addClass('dia-seleccionado');
                },


                drop: function(info) {
                    var originalEventObject = $(info.draggedEl).data('eventObject');

                    var droppedEventData = {
                        Titulo: originalEventObject.title,
                        FechaInicio: info.date.toISOString(),
                        TodoElDia: originalEventObject.allDay,
                        Color: originalEventObject.backgroundColor,
                        Descripcion: originalEventObject.description || ""
                    };

                    $.ajax({
                        url: '/api/EventosAgenda',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(droppedEventData),
                        success: function(response) {
                            calendar.addEvent({
                                id: response.id,
                                title: response.titulo,
                                start: response.fechaInicio,
                                end: response.fechaFin,
                                allDay: response.todoElDia,
                                backgroundColor: response.color,
                                borderColor: response.color,
                                textColor: '#fff'
                            });
                            if (checkbox && checkbox.checked) {
                                info.draggedEl.remove();
                            }

                            Swal.fire({
                                icon: 'success',
                                title: '¡Evento Programado!',
                                text: 'El evento ha sido añadido a tu calendario.',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        },
                        error: function(xhr, status, error) {

                            var errorMessage = xhr.responseText || 'Error desconocido al guardar el evento arrastrado.';
                            Swal.fire({
                                icon: 'error',
                                title: 'Error al Programar',
                                text: errorMessage,
                                confirmButtonText: 'Cerrar'
                            });
                            console.error('Error:', xhr.responseText);
                        }
                    });
                },


                select: function(info) {

                    Swal.fire({
                        title: 'Título del Evento:',
                        input: 'text',
                        inputPlaceholder: 'Ingresa el título aquí',
                        showCancelButton: true,
                        confirmButtonText: 'Crear Evento',
                        cancelButtonText: 'Cancelar',
                        inputValidator: (value) => {
                            if (!value) {
                                return '¡Necesitas escribir algo!'
                            }
                        }
                    }).then((result) => {
                        if (result.isConfirmed && result.value) {
                            var title = result.value;
                            var newEventData = {
                                Titulo: title,
                                FechaInicio: info.startStr,
                                FechaFin: info.endStr,
                                TodoElDia: info.allDay,
                                Color: currColor,
                                Descripcion: ""
                            };

                            $.ajax({
                                url: '/api/EventosAgenda',
                                type: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify(newEventData),
                                success: function(response) {
                                    calendar.addEvent({
                                        id: response.id,
                                        title: response.titulo,
                                        start: response.fechaInicio,
                                        end: response.fechaFin,
                                        allDay: response.todoElDia,
                                        backgroundColor: response.color,
                                        borderColor: response.color,
                                        textColor: '#fff'
                                    });
                                    calendar.unselect();

                                    Swal.fire({
                                        icon: 'success',
                                        title: '¡Evento Creado!',
                                        text: `"${response.titulo}" ha sido creado en el calendario.`,
                                        showConfirmButton: false,
                                        timer: 1500
                                    });
                                },
                                error: function(xhr, status, error) {

                                    var errorMessage = xhr.responseText || 'Error desconocido al crear el evento.';
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error al Crear',
                                        text: errorMessage,
                                        confirmButtonText: 'Cerrar'
                                    });
                                    console.error('Error:', xhr.responseText);
                                }
                            });
                        }
                        calendar.unselect();
                    });
                },

                eventDrop: function(info) {
                       
                    console.log("--- DEBUG: eventDrop ---");
       
                    var today = new Date();
                    today.setHours(0, 0, 0, 0); 
                    console.log("Fecha actual (today - JS Date): ", today.toISOString()); 

        
                    var newStartDate = new Date(info.event.start);
                    newStartDate.setHours(0, 0, 0, 0); 
                    console.log("Nueva fecha de inicio del evento (newStartDate - JS Date): ", newStartDate.toISOString());

        
                    var isBeforeToday = newStartDate < today;
                    console.log("¿newStartDate es anterior a today?: ", isBeforeToday);
                    console.log("--- FIN DE DEPURACIÓN ---");


      
                    if (isBeforeToday) { 
                        info.revert(); 
                        Swal.fire({
                            icon: 'error',
                            title: '¡Error al Mover!',
                            text: 'No puedes mover un evento a una fecha anterior a hoy.',
                            confirmButtonText: 'Entendido'
                        });
                        return; 
                    }


                    var eventId = info.event.id;
                    var updatedEventData = {
                        Id: eventId,
                        Titulo: info.event.title,
                        FechaInicio: info.event.start.toISOString(),
                        FechaFin: info.event.end ? info.event.end.toISOString() : null,
                        TodoElDia: info.event.allDay,
                        Color: info.event.backgroundColor,
                        Descripcion: info.event.extendedProps.description || ""
                    };

                    $.ajax({
                        url: '/api/EventosAgenda/' + eventId,
                        type: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify(updatedEventData),
                        success: function() {
                            console.log('Evento actualizado (arrastre) con éxito.');

                            Swal.fire({
                                icon: 'success',
                                title: '¡Actualizado!',
                                text: 'El evento ha sido movido.',
                                showConfirmButton: false,
                                timer: 1000
                            });
                        },
                        error: function(xhr, status, error) {

                            var errorMessage = xhr.responseText || 'Error desconocido al actualizar el evento.';
                            Swal.fire({
                                icon: 'error',
                                title: 'Error al Mover',
                                text: errorMessage,
                                confirmButtonText: 'Cerrar'
                            });
                            console.error('Error:', xhr.responseText);
                            info.revert();
                        }
                    });
                },

                eventResize: function(info) {

                        
                    console.log("--- DEBUG: eventResize ---");
                    var today = new Date();
                    today.setHours(0, 0, 0, 0);
                    console.log("Fecha actual (today - JS Date): ", today.toISOString());

                    var newStartDate = new Date(info.event.start);
                    newStartDate.setHours(0, 0, 0, 0);
                    console.log("Nueva fecha de inicio del evento (newStartDate - JS Date): ", newStartDate.toISOString());

                    var newEndDate = info.event.end ? new Date(info.event.end) : null;
                    if (newEndDate) {
                        newEndDate.setHours(0, 0, 0, 0);
                        console.log("Nueva fecha de fin del evento (newEndDate - JS Date): ", newEndDate.toISOString());
                    }

                    var isStartDateBeforeToday = newStartDate < today;
                    console.log("¿newStartDate es anterior a today?: ", isStartDateBeforeToday);

                    var isEndDateBeforeToday = false;
                    if (newEndDate) {
                        isEndDateBeforeToday = newEndDate < today;
                        console.log("¿newEndDate es anterior a today?: ", isEndDateBeforeToday);
                    }
                    console.log("--- FIN DE DEPURACIÓN ---");


      
                    if (isStartDateBeforeToday) {
                        info.revert();
                        Swal.fire({
                            icon: 'error',
                            title: '¡Error al Redimensionar!',
                            text: 'No puedes redimensionar un evento para que comience en una fecha anterior a hoy.',
                            confirmButtonText: 'Entendido'
                        });
                        return;
                    }

        
                    if (newEndDate && isEndDateBeforeToday) {
                        info.revert();
                        Swal.fire({
                            icon: 'error',
                            title: '¡Error al Redimensionar!',
                            text: 'La fecha de finalización no puede ser anterior a hoy.',
                            confirmButtonText: 'Entendido'
                        });
                        return;
                    }


                    var eventId = info.event.id;
                    var updatedEventData = {
                        Id: eventId,
                        Titulo: info.event.title,
                        FechaInicio: info.event.start.toISOString(),
                        FechaFin: info.event.end ? info.event.end.toISOString() : null,
                        TodoElDia: info.event.allDay,
                        Color: info.event.backgroundColor,
                        Descripcion: info.event.extendedProps.description || ""
                    };

                    $.ajax({
                        url: '/api/EventosAgenda/' + eventId,
                        type: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify(updatedEventData),
                        success: function() {
                            console.log('Evento actualizado (redimensionar) con éxito.');

                            Swal.fire({
                                icon: 'success',
                                title: '¡Actualizado!',
                                text: 'El evento ha sido redimensionado.',
                                showConfirmButton: false,
                                timer: 1000
                            });
                        },
                        error: function(xhr, status, error) {

                            var errorMessage = xhr.responseText || 'Error desconocido al actualizar el evento.';
                            Swal.fire({
                                icon: 'error',
                                title: 'Error al Redimensionar',
                                text: errorMessage,
                                confirmButtonText: 'Cerrar'
                            });
                            console.error('Error:', xhr.responseText);
                            info.revert();
                        }
                    });
                },

                eventClick: function(info) {

                    Swal.fire({
                        title: '¿Estás seguro?',
                        text: `¿Quieres eliminar el evento "${info.event.title}"?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sí, eliminar',
                        cancelButtonText: 'Cancelar'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            var eventId = info.event.id;
                            $.ajax({
                                url: '/api/EventosAgenda/' + eventId,
                                type: 'DELETE',
                                success: function() {
                                    info.event.remove();

                                    Swal.fire(
                                        '¡Eliminado!',
                                        'El evento ha sido eliminado.',
                                        'success'
                                    );
                                    console.log('Evento eliminado con éxito.');
                                },
                                error: function(xhr, status, error) {

                                    var errorMessage = xhr.responseText || 'Error desconocido al eliminar el evento.';
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error al Eliminar',
                                        text: errorMessage,
                                        confirmButtonText: 'Cerrar'
                                    });
                                    console.error('Error:', xhr.responseText);
                                }
                            });
                        }
                    });
                }
            });

            calendar.render();
        });
    </script>
}